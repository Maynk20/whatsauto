{
  "name": "whatsauto-backend",
  "version": "1.0.0",
  "description": "Backend API Server and Background Worker for WhatsAuto",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/index.js",
    "dev:worker": "node --watch src/workers/index.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "keywords": [
    "whatsapp",
    "backend",
    "express",
    "supabase"
  ],
  "author": "Mayank Thakkar",
  "license": "MIT"
}
